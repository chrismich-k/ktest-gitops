# Argo CD Application for the demo Dagster workspace (one entry per code
# location). Copy it to a .yaml file, replace the values marked CHANGE and
# apply it: kubectl apply -f argocd/ktest-demo-dagster-workspace.yaml
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ktest-demo-dagster-workspace
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/your-account/ktest-gitops.git # CHANGE
    targetRevision: HEAD
    path: apps/dagster-workspace/overlays/demo
  destination:
    server: https://kubernetes.default.svc
    namespace: dagster # CHANGE: as in the overlay
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
